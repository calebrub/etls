      "id": "5f1bc731-97ea-46b6-a83d-6b5860d5bfa4",
      "name": "Parse Fetch Summary CSV"
    },
    {
      "parameters": {
        "jsCode": "const table1 = $('Parse Identifier Summary CSV').all();\nconst table2 = $('Parse Fetch Summary CSV').all();\n\nconst map2 = {};\nfor (const item of table2) {\n  const data = item.json;\n  const key = `${data.instance_key}_${data.customer_account}_${data.report_name}`.toLowerCase();\n  map2[key] = data;\n}\n\nconst joined = [];\nfor (const item of table1) {\n  const data = item.json;\n  const key = `${data.instance_key}_${data.customer_account}_${data.report_name}`.toLowerCase();\n  const match = map2[key] || {};\n  \n  joined.push({\n    json: {\n      instance_key: data.instance_key,\n      customer_account: data.customer_account,\n      customer_name: data.customer_name || match.customer_name,\n      report_name: data.report_name,\n      report_id: data.report_id || match.report_id,\n      filter_id: data.filter_id,\n      run_http_status: data.http_status,\n      run_api_status: data.api_status,\n      identifier: data.identifier,\n      run_status_message: data.status_message,\n      run_retries: data.retries,\n      db_updated: data.db_updated,\n      run_time_taken: data.time_taken,\n      fetch_http_status: match.http_status,\n      fetch_api_status: match.api_status,\n      fetch_status_message: match.status_message,\n      fetch_retries: match.retries,\n      rows_fetched: match.rows_fetched,\n      file_written: match.file_written,\n      load_status: match.load_status,\n      rows_inserted: match.rows_inserted,\n      rows_duplicate: match.rows_duplicate,\n      load_error: match.load_error\n    }\n  });\n}\n\nreturn joined;"
      },
      "id": "e458e0a3-a9f8-410a-b286-90516b328a9b",
